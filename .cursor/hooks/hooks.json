{
    "version": 1,
    "hooks": {
        "sessionStart": [
            {
                "command": "python3 ./hooks/monthly-context-cleanup.py"
            }
        ],
        "afterAgentResponse": [
            {
                "command": "./hooks/prose-style.py"
            }
        ],
        "stop": [
            {
                "command": "./hooks/prose-style.py",
                "loop_limit": 1
            }
        ]
    }
}
