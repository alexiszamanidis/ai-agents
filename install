#!/usr/bin/env bash
set -euo pipefail

log() { printf '%s\n' "$*"; }
error() { printf 'ERROR: %s\n' "$*" >&2; }

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
skills_dir="$repo_root/skills"
link_dir="$HOME/.agents/skills"
instruction_source="$repo_root/AGENTS.md"
cursor_rule_source="$repo_root/.cursor/rules/global-agent-instructions.mdc"
cursor_rules_dir="$HOME/.cursor/rules"
cursor_instruction_target="$cursor_rules_dir/global-agent-instructions.mdc"
cursor_hook_config_source="$repo_root/.cursor/hooks/hooks.json"
cursor_monthly_hook_source="$repo_root/.cursor/hooks/monthly-context-cleanup.py"
cursor_hooks_dir="$HOME/.cursor/hooks"
cursor_hook_config_target="$HOME/.cursor/hooks.json"
cursor_monthly_hook_target="$cursor_hooks_dir/monthly-context-cleanup.py"
legacy_hook_script_target="$cursor_hooks_dir/no-dashes.py"
retired_hook_script_target="$cursor_hooks_dir/prose-style.py"
legacy_cursor_instruction_target="$HOME/.cursor/AGENTS.md"
copilot_instruction_target="$HOME/.github/copilot-instructions.md"

log "Starting AI agents install from $repo_root"
log "Skills dir: $skills_dir"
log "Link dir: $link_dir"
log "Instruction source: $instruction_source"
log "Cursor rule source: $cursor_rule_source"
log "Cursor hook config: $cursor_hook_config_source"
log "Cursor monthly hook: $cursor_monthly_hook_source"

mkdir -p "$link_dir"
if [[ ! -d "$link_dir" ]]; then
  error "failed to create or validate skills link directory: $link_dir"
  exit 1
fi

if [[ ! -d "$skills_dir" ]]; then
  echo "WARNING: skills directory does not exist: $skills_dir" >&2
  exit 0
fi

declare -A desired_links=()
log "Linking skills from $skills_dir to $link_dir"
while IFS= read -r -d '' skill_dir; do
  skill_name="$(basename "$skill_dir")"
  desired_links["$skill_name"]=1
  target_link="$link_dir/$skill_name"
  log "  -> linking $skill_name"
  ln -sfn "$skill_dir" "$target_link"
done < <(find "$skills_dir" -maxdepth 1 -mindepth 1 -type d -print0)

log "Removing stale skill symlinks in $link_dir"
while IFS= read -r -d '' existing_link; do
  link_name="$(basename "$existing_link")"
  if [[ -z "${desired_links[$link_name]:-}" ]]; then
    existing_target="$(readlink "$existing_link")"
    if [[ "$existing_target" == "$skills_dir/"* ]]; then
      log "  -> removing stale managed link $link_name"
      rm -f "$existing_link"
    else
      log "  -> retaining unmanaged link $link_name"
    fi
  fi
done < <(find "$link_dir" -maxdepth 1 -mindepth 1 -type l -print0)

log "Linking global instruction files"

if [[ -f "$cursor_rule_source" ]]; then
  log "  -> $cursor_instruction_target"
  mkdir -p "$cursor_rules_dir"
  ln -sfn "$cursor_rule_source" "$cursor_instruction_target"
else
  log "Cursor rule source not found: $cursor_rule_source"
fi

if [[ -L "$legacy_cursor_instruction_target" &&
  "$(readlink "$legacy_cursor_instruction_target")" == "$instruction_source" ]]; then
  log "  -> removing obsolete $legacy_cursor_instruction_target"
  rm -f "$legacy_cursor_instruction_target"
fi

if [[ -f "$instruction_source" ]]; then
  log "  -> $copilot_instruction_target"
  mkdir -p "$(dirname "$copilot_instruction_target")"
  ln -sfn "$instruction_source" "$copilot_instruction_target"
else
  log "Instruction source not found: $instruction_source"
fi

log "Linking Cursor hooks"

if [[ -f "$cursor_hook_config_source" && -f "$cursor_monthly_hook_source" ]]; then
  mkdir -p "$cursor_hooks_dir"
  log "  -> $cursor_hook_config_target"
  ln -sfn "$cursor_hook_config_source" "$cursor_hook_config_target"
  log "  -> $cursor_monthly_hook_target"
  ln -sfn "$cursor_monthly_hook_source" "$cursor_monthly_hook_target"
  if [[ -L "$legacy_hook_script_target" ]]; then
    log "  -> removing obsolete $legacy_hook_script_target"
    rm -f "$legacy_hook_script_target"
  fi
  if [[ -L "$retired_hook_script_target" || -f "$retired_hook_script_target" ]]; then
    log "  -> removing retired $retired_hook_script_target"
    rm -f "$retired_hook_script_target"
  fi
else
  log "Cursor hook source not found under $repo_root/.cursor/hooks"
fi
